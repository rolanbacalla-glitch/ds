rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL SAFETY NET: Default Deny All
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HARDENED GLOBAL PRIMITIVES
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'rolan.bacalla@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // =========================================================================
    // VALIDATION BLUEPRINTS (Synchronised with firebase-blueprint.json)
    // =========================================================================
    function isValidPortfolioSettings(data) {
      return data.keys().hasAll([
          'exportLockEnabled',
          'copyLockEnabled',
          'allowAccessRequests',
          'ownerDisplayName',
          'lockMessage',
          'defaultPresetName',
          'updatedAt',
          'updatedBy'
        ])
        && data.keys().hasOnly([
          'exportLockEnabled',
          'copyLockEnabled',
          'allowAccessRequests',
          'ownerDisplayName',
          'lockMessage',
          'defaultPresetName',
          'updatedAt',
          'updatedBy'
        ])
        && data.exportLockEnabled is bool
        && data.copyLockEnabled is bool
        && data.allowAccessRequests is bool
        && data.ownerDisplayName is string
        && data.ownerDisplayName.size() >= 1
        && data.ownerDisplayName.size() <= 80
        && data.lockMessage is string
        && data.lockMessage.size() >= 1
        && data.lockMessage.size() <= 300
        && data.defaultPresetName is string
        && data.defaultPresetName.size() >= 1
        && data.defaultPresetName.size() <= 60
        && data.updatedAt is timestamp
        && data.updatedAt == request.time
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && isValidId(data.grantedBy)
        && data.grantedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'provider',
          'emailVerified',
          'createdAt',
          'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'provider',
          'emailVerified',
          'createdAt',
          'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.provider is string
        && data.provider in ['google.com', 'apple.com', 'password']
        && data.emailVerified is bool
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidExportApproval(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'approvedBy', 'note', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'approvedBy', 'note', 'grantedAt'])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && isValidId(data.approvedBy)
        && data.approvedBy == request.auth.uid
        && data.note is string
        && data.note.size() <= 240
        && data.grantedAt is timestamp
        && data.grantedAt == request.time;
    }

    function isValidAccessRequest(data) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'organisation',
          'reason',
          'provider',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'organisation',
          'reason',
          'provider',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.organisation is string
        && data.organisation.size() >= 1
        && data.organisation.size() <= 100
        && data.reason is string
        && data.reason.size() >= 5
        && data.reason.size() <= 400
        && data.provider is string
        && data.provider in ['google.com', 'apple.com', 'password']
        && data.status is string
        && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'actorEmail', 'action', 'target', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'target', 'createdAt'])
        && isValidId(data.actorUid)
        && data.actorUid == request.auth.uid
        && data.actorEmail is string
        && data.actorEmail.size() >= 3
        && data.actorEmail.size() <= 160
        && data.action is string
        && data.action in [
          'export_download',
          'export_copy',
          'blocked_export_attempt',
          'access_requested',
          'access_approved',
          'access_revoked',
          'settings_updated'
        ]
        && data.target is string
        && data.target.size() >= 1
        && data.target.size() <= 160
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // =========================================================================
    // COLLECTION 1: /settings/{settingId}
    // Public read strictly limited to the non-PII 'portfolio' config document.
    // =========================================================================
    match /settings/{settingId} {
      allow get: if isValidId(settingId) && (settingId == 'portfolio' || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isVerifiedUser()
        && isValidId(settingId)
        && isValidPortfolioSettings(incoming())
        && isAdmin();
      allow delete: if false;
    }

    // =========================================================================
    // COLLECTION 2: /admins/{uid}
    // =========================================================================
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isValidAdminRecord(incoming())
        && incoming().uid == uid
        && isAdmin();
      allow update: if false;
      allow delete: if isVerifiedUser()
        && isValidId(uid)
        && uid != request.auth.uid
        && isAdmin();
    }

    // =========================================================================
    // COLLECTION 3: /users/{uid} (Strict PII Isolation)
    // =========================================================================
    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isValidUserProfile(incoming())
        && isOwner(uid)
        && incoming().uid == uid
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            isOwner(uid)
            && incoming().lastLoginAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'email',
              'provider',
              'emailVerified',
              'lastLoginAt'
            ])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(uid)
        && uid != request.auth.uid
        && isAdmin();
    }

    // =========================================================================
    // COLLECTION 4: /exportApprovals/{uid} (Admin-Managed Export Allowlist)
    // =========================================================================
    match /exportApprovals/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isVerifiedUser()
        && isValidId(uid)
        && isValidExportApproval(incoming())
        && incoming().uid == uid
        && isAdmin();
      allow delete: if isVerifiedUser() && isValidId(uid) && isAdmin();
    }

    // =========================================================================
    // COLLECTION 5: /accessRequests/{uid} (Terminal State Locked)
    // =========================================================================
    match /accessRequests/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isValidAccessRequest(incoming())
        && isOwner(uid)
        && incoming().uid == uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isValidAccessRequest(incoming())
        && (
          (
            isAdmin()
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            isOwner(uid)
            && existing().status == 'pending'
            && incoming().status == 'pending'
            && incoming().uid == existing().uid
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'organisation',
              'reason',
              'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(uid) && isAdmin();
    }

    // =========================================================================
    // COLLECTION 6: /auditLogs/{logId} (Append-Only Admin-Readable)
    // =========================================================================
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isVerifiedUser()
        && isValidId(logId)
        && isValidAuditLog(incoming())
        && (
          isAdmin()
          || incoming().action in [
            'export_download',
            'export_copy',
            'blocked_export_attempt',
            'access_requested'
          ]
        );
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(logId) && isAdmin();
    }
  }
}
